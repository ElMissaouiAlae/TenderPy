# PostgreSQL connection string
DB_URL=postgresql://user:password@localhost:5432/database?sslmode=require

# AWS S3 destination for DCE archives
S3_BUCKET_NAME=your-s3-bucket-name
S3_REGION=us-east-1

# Optional SQLAlchemy connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
